# Docker image and container names
COMFYUI_IMAGE_NAME=comfyui-comfyui
COMFYUI_CONTAINER_NAME=comfyui
COMFYUI_MCP_CONTAINER_NAME=comfyui-mcp

# Host bindings
COMFYUI_BIND_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_MCP_PORT=9000

# GPU runtime
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Optional provider token forwarded into the ComfyUI container
HF_TOKEN=
